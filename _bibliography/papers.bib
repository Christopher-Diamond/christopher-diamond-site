@article{diamond2026indescribable,
  author      = {Diamond, Christopher L.},
  title       = {The {\textquoteleft}Indescribable Country{\textquoteright}: Locating {Mithila} between {Bengal} and the {Hindi} Heartland in {Raghunandana Das}'s Mithilānāṭaka},
  journal     = {Asian Ethnology},
  volume      = {85},
  number      = {1},
  year        = {2026},
  url         = {https://asianethnology.org/article/164481-the-indescribable-country-locating-mithila-between-bengal-and-the-hindi-heartland-in-raghunandana-das-s-_mithilana-aka_},
  html        = {https://asianethnology.org/article/164481-the-indescribable-country-locating-mithila-between-bengal-and-the-hindi-heartland-in-raghunandana-das-s-_mithilana-aka_},
  abstract    = {This article examines the way multilingualism was employed by Raghunandana Das in his 1923 play, the “Drama of Mithila” (mithilānāṭaka), to shift Mithila (the region) and Maithili (the language) from its historically marginal position in the social geography of the newly emerging Indian nation. Since the late nineteenth century up to the present, Maithil authors and elites engaged in promoting their language and cultural region on a national stage found themselves disadvantaged and caught between the hegemony of the Hindi heartland and the political and cultural powerhouse of Bengal. In this context, Raghunandana Das’s moralistic drama written in Maithili, Hindi, Bengali, and Sanskrit renegotiates Maithili/Mithila’s marginal status by emphasizing its engagement with multiple elite cultural milieux—the national, the Sanskritic/traditional, and the modern. For Das, this renegotiation works to leverage the region’s credentials as an independent cultural sphere from which others might take influence.},
  pdf         = {https://asianethnology.org/article/164481.pdf},
  doi         = {10.18874/ae.85.1.03},
  preview     = {bengal-1912-pan.webp},
  abbr        = {AE},
  bibtex_show = {true},
  selected    = {true},
  note        = {Special issue: Critical Contours of Mithila Studies. Open access}
}

@article{prakash2026introduction,
  author      = {Prakash, Pranav and Diamond, Christopher L. and Davis, Coralynn V.},
  title       = {Guest Editors' Introduction: Defining and Contextualizing {Mithila} Studies},
  journal     = {Asian Ethnology},
  volume      = {85},
  number      = {1},
  year        = {2026},
  url         = {https://asianethnology.org/article/164479-guest-editors-introduction-defining-and-contextualizing-mithila-studies},
  html        = {https://asianethnology.org/article/164479-guest-editors-introduction-defining-and-contextualizing-mithila-studies},
  abstract    = {Our introduction establishes “Mithila Studies” as a new field of academic inquiry focused on the cultures, communities, and histories of Maithili-speaking peoples worldwide. We critique the limitations of previous “Maithili Studies” approaches, which have privileged upper-caste Hindu male perspectives, and which are mired in the problems of colonialist historiography, Orientalist philology and postcolonial communalism. We envision an inclusive, ethical, and critical field of inquiry that empowers marginalized voices and experiences, especially those of women, lower castes, and religious minorities; challenges colonial and nationalist construction of regional identities; explores Mithila’s liminal status in global cultures and academies; and posits Mithila subjects as viable bases of multifaceted research projects. By engaging diverse disciplinary approaches, archives, and communities, we seek to develop Mithila Studies as a field that resists parochialism, promotes comparative analysis and collaborative research, and provides new perspectives on key issues in the humanities and social sciences.},
  pdf         = {https://asianethnology.org/article/164479.pdf},
  doi         = {10.18874/ae.85.1.02},
  preview     = {mithila-painting.jpg},
  abbr        = {AE},
  bibtex_show = {true},
  selected    = {true},
  note        = {Open access}
}

